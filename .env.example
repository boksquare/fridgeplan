# Postgres connection. docker-compose builds this for you; set it directly for
# local `npm run dev` against your own Postgres.
DATABASE_URL="postgresql://fridgeplan:fridgeplan@localhost:5432/fridgeplan?schema=public"

# Auth.js session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL the app is served from (used for auth callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Auth.js rejects requests from hosts it cannot verify. Set this when the app
# runs behind a proxy or in a container (docker-compose sets it for you).
AUTH_TRUST_HOST="true"

# Password for the bundled Postgres container (docker-compose only).
POSTGRES_PASSWORD="fridgeplan"

# Which published image to run. FRIDGEPLAN_TAG pins a release instead of
# tracking latest; FRIDGEPLAN_IMAGE points at a fork's image.
# FRIDGEPLAN_IMAGE="ghcr.io/boksquare/fridgeplan"
# FRIDGEPLAN_TAG="latest"

# Host port docker-compose publishes the app on.
APP_PORT="3000"

# --- Recipe sources ---------------------------------------------------------
# TheMealDB needs no key and its results are cached indefinitely with
# attribution. Spoonacular is optional; per their terms its results may only be
# cached for 1 hour, so it is treated as a pass-through source. Stop using it
# and delete what it gave you with:
#   npm run purge:provider spoonacular
# SPOONACULAR_API_KEY=""

# Which sources to use, in order. Defaults to every source that is configured.
# RECIPE_PROVIDERS="themealdb,spoonacular"

# Point a source somewhere else (a mirror, or your own provider).
# THEMEALDB_BASE_URL="https://www.themealdb.com/api/json/v1/1"
# SPOONACULAR_BASE_URL="https://api.spoonacular.com"

# --- AI provider ------------------------------------------------------------
# Used for ingredient substitutions. In public hosted mode this config is the
# only way to set it and end users cannot change it; in personal self-host mode
# it is the fallback until the user picks one in Settings → AI provider.
#
# Uncomment the lines you need — remove the leading "#", or they stay comments
# and the app reports no provider configured.
#
# AI_PROVIDER: nvidia_nim | gemini | openai_compatible | anthropic | claude_code
#   claude_code runs the `claude` CLI installed on the host and is refused in
#   public hosted mode.
# AI_MODEL: the provider's own model id. NVIDIA NIM namespaces theirs as
#   publisher/model, e.g. meta/llama-3.1-70b-instruct.
# AI_BASE_URL: optional — only needed to override a provider's default endpoint,
#   or to point openai_compatible at something else.
#
# Scanning a receipt photo needs a model that accepts images. Gemini, Anthropic
# and the OpenAI-compatible defaults do; claude_code never does (the CLI takes
# no image); NVIDIA NIM does only if AI_MODEL is a vision model, e.g.
# meta/llama-3.2-11b-vision-instruct. Settings → Diagnostics says which you have.
#
# AI_PROVIDER="nvidia_nim"
# AI_MODEL="meta/llama-3.1-70b-instruct"
# AI_API_KEY="nvapi-..."
# AI_BASE_URL=""

# Path to the `claude` binary, if it is not on PATH.
# CLAUDE_CODE_BIN="claude"

# Stored provider keys are encrypted with this; falls back to AUTH_SECRET.
# AI_ENCRYPTION_KEY=""

# --- Uploads ----------------------------------------------------------------
# Where private-recipe photos are written. docker-compose mounts a volume here.
UPLOAD_DIR="./uploads"
